# Executable built from https://github.com/Equim-chan/mjai-reviewer
MJTUTOR_REVIEWER_BIN=/absolute/path/to/mjai-reviewer

# Mortal launcher and model configuration used by mjai-reviewer.
MJTUTOR_MORTAL_EXE=/absolute/path/to/Mortal/mortal/mortal
MJTUTOR_MORTAL_CONFIG=/absolute/path/to/Mortal/mortal/config.toml

# Optional. The default is ~/.local/share/mjtutor.
# MJTUTOR_DATA_DIR=/absolute/path/to/local/data

# Optional. Koromo access token supplied by the site owner when required.
# MJTUTOR_KOROMO_TOKEN=replace-with-your-token

# Optional. A full hanchan can take time on CPU.
MJTUTOR_TIMEOUT_SECONDS=1800
